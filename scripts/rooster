#!/usr/bin/env bash
# Rooster build tool (macOS).
#
#   scripts/rooster doctor      check tools, disk and memory
#   scripts/rooster setup       fetch + download + prepare + configure dev
#   scripts/rooster fetch       check out Helium at the commits in config/pins.ini
#   scripts/rooster download    download the Chromium source and build tools
#   scripts/rooster prepare     prune, patch, substitute and rebrand the source
#   scripts/rooster icons       install and compile the macOS app icon (prepare runs it)
#   scripts/rooster configure [dev|release]
#   scripts/rooster build [ninja targets...]   (default: chrome)
#   scripts/rooster run [args...]              run the dev build on its own profile
#   scripts/rooster reset       delete the prepared source (keeps downloads)
#
# Environment:
#   ROOSTER_BUILD_DIR  where everything large goes (default: ./build). A dev
#                      build needs ~45 GB (60 GB free to be safe).
#   ROOSTER_JOBS       parallel compile jobs (default: 6, sized for 16 GB RAM)
#   SCCACHE_CACHE_SIZE compiler cache limit (default here: 5G)

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD="${ROOSTER_BUILD_DIR:-$ROOT/build}"
UPSTREAM="$BUILD/upstream"
HELIUM="$UPSTREAM/helium"
HELIUM_MAC="$UPSTREAM/helium-macos"
SRC="$BUILD/src"
OUT="$SRC/out/Default"
CACHE="$BUILD/download_cache"
PREPARED="$BUILD/.prepared"
JOBS="${ROOSTER_JOBS:-6}"

log() { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

pin() {
  python3 - "$ROOT/config/pins.ini" "$1" "$2" <<'EOF'
import configparser, sys
config = configparser.ConfigParser()
config.read(sys.argv[1])
print(config[sys.argv[2]][sys.argv[3]])
EOF
}

product_name() {
  python3 - "$ROOT/config/branding.ini" <<'EOF'
import configparser, sys
config = configparser.ConfigParser()
config.read(sys.argv[1])
print(config['product']['name'])
EOF
}

host_arch() {
  case "$(uname -m)" in
    arm64) echo arm64 ;;
    x86_64) echo x64 ;;
    *) die "unsupported host architecture: $(uname -m)" ;;
  esac
}

cmd_doctor() {
  local ok=true
  [ "$(uname -s)" = Darwin ] || { echo "✗ macOS required (this tool builds the Mac version)"; ok=false; }
  for tool in git python3 xcodebuild; do
    if command -v "$tool" >/dev/null 2>&1; then echo "✓ $tool"; else echo "✗ $tool missing"; ok=false; fi
  done
  python3 -c 'import PIL' 2>/dev/null && echo "✓ python: pillow" || { echo "✗ python: pip3 install pillow"; ok=false; }
  if command -v sccache >/dev/null 2>&1 || command -v ccache >/dev/null 2>&1; then
    echo "✓ compiler cache"
  else
    echo "• no sccache/ccache: rebuilds after 'reset' start from zero (brew install sccache)"
  fi
  if [ "$(uname -s)" = Darwin ]; then
    local mem_gb free_gb
    mem_gb=$(( $(sysctl -n hw.memsize) / 1073741824 ))
    mkdir -p "$BUILD"
    free_gb=$(df -g "$BUILD" | awk 'NR==2 {print $4}')
    echo "• memory: ${mem_gb} GB → ROOSTER_JOBS=${JOBS}"
    # A dev build (no symbols, sccache capped) needs roughly 45 GB: ~16 GB of
    # source, ~3.5 GB of cached downloads, 20-30 GB of build output.
    if [ "$free_gb" -lt 60 ]; then
      echo "✗ ${free_gb} GB free at $BUILD; at least 60 GB needed for a dev build"
      ok=false
    elif [ "$free_gb" -lt 100 ]; then
      echo "• ${free_gb} GB free at $BUILD: enough for a dev build; keep symbol_level = 0 and"
      echo "  sccache capped (SCCACHE_CACHE_SIZE, default 5G here); release builds need far more"
    else
      echo "✓ ${free_gb} GB free at $BUILD"
    fi
  fi
  $ok || die "fix the items marked ✗"
}

checkout() {
  local name="$1" dir="$2" url commit
  url="$(pin "$name" url)"
  commit="$(pin "$name" commit)"
  if [ ! -d "$dir/.git" ]; then
    git init -q "$dir"
    git -C "$dir" remote add origin "$url"
  fi
  if [ "$(git -C "$dir" rev-parse -q --verify HEAD 2>/dev/null || true)" != "$commit" ]; then
    log "fetching $name $(pin "$name" tag)"
    git -C "$dir" fetch -q --depth 1 origin "$commit"
    git -C "$dir" checkout -q --detach FETCH_HEAD
  fi
  [ "$(git -C "$dir" rev-parse HEAD)" = "$commit" ] || die "$name is not at $commit"
}

cmd_fetch() {
  mkdir -p "$UPSTREAM"
  checkout helium "$HELIUM"
  checkout helium-macos "$HELIUM_MAC"
  local chromium
  chromium="$(cat "$HELIUM/chromium_version.txt")"
  [ "$chromium" = "$(pin chromium version)" ] ||
    die "helium wants Chromium $chromium but config/pins.ini says $(pin chromium version)"
}

cmd_download() {
  cmd_fetch
  [ -e "$PREPARED" ] && die "source is already prepared; run 'reset' first"
  # Of Helium's extra downloads, only the search engine assets: its uBlock
  # Origin and onboarding page are left out of Rooster.
  python3 - "$HELIUM/deps.ini" "$BUILD/deps.rooster.ini" <<'EOF'
import sys
lines, keep, out = open(sys.argv[1]).read().splitlines(), False, []
for line in lines:
    if line.startswith('['):
        keep = line.strip() == '[search_engines_data]'
    if keep:
        out.append(line)
if not out:
    sys.exit('[search_engines_data] missing from helium deps.ini')
open(sys.argv[2], 'w').write('\n'.join(out) + '\n')
EOF
  local inis=("$HELIUM/downloads.ini" "$HELIUM_MAC/downloads.$(host_arch).ini" "$BUILD/deps.rooster.ini")
  mkdir -p "$CACHE" "$SRC"
  log "downloading Chromium $(pin chromium version) (several GB, cached in $CACHE)"
  python3 "$HELIUM/utils/downloads.py" retrieve -i "${inis[@]}" -c "$CACHE"
  log "unpacking into $SRC"
  python3 "$HELIUM/utils/downloads.py" unpack -i "${inis[@]}" -c "$CACHE" "$SRC"
}

cmd_prepare() {
  [ -e "$PREPARED" ] && die "source is already prepared; run 'reset' and 'download' to start over"
  [ -f "$SRC/chrome/VERSION" ] || die "no Chromium source in $SRC; run 'download'"

  log "pruning prebuilt binaries"
  # Helium's list also covers its onboarding and uBlock downloads, which
  # Rooster doesn't fetch; pruning fails on files that aren't there.
  grep -v -e '^components/helium_onboarding/' -e '^third_party/ublock/' \
    "$HELIUM/pruning.list" > "$BUILD/pruning.rooster.list"
  if [ ! -e "$BUILD/.pruned" ]; then
    python3 "$HELIUM/utils/prune_binaries.py" --keep-build-dependencies "$SRC" "$BUILD/pruning.rooster.list"
    touch "$BUILD/.pruned"
  fi

  log "applying patches (Helium, helium-macos, Rooster)"
  python3 "$ROOT/scripts/merge_patches.py" --helium "$HELIUM" --helium-macos "$HELIUM_MAC" \
    --rooster "$ROOT" --skip "$ROOT/config/skip.txt" --out "$BUILD/patches"
  python3 "$HELIUM/utils/patches.py" apply "$SRC" "$BUILD/patches"
  touch "$PREPARED"

  log "adding Rooster's own code and vendored crates"
  python3 "$ROOT/scripts/install_overlay.py" --overlay "$ROOT/src" --tree "$SRC"

  log "domain substitution"
  python3 "$ROOT/scripts/domsub_list.py" --list "$HELIUM/domain_substitution.list" \
    --keep "$ROOT/config/domsub-keep.txt" --out "$BUILD/domain_substitution.rooster.list"
  python3 "$HELIUM/utils/domain_substitution.py" apply -r "$HELIUM/domain_regex.list" \
    -f "$BUILD/domain_substitution.rooster.list" "$SRC"

  log "name substitution (Chromium → Helium), translations, version"
  python3 "$HELIUM/utils/name_substitution.py" --sub -t "$SRC"
  python3 "$HELIUM/utils/i18n_apply.py" -t "$SRC"
  python3 "$HELIUM/utils/helium_version.py" --tree "$HELIUM" --platform-tree "$HELIUM_MAC" \
    --chromium-tree "$SRC"

  log "icons"
  python3 "$HELIUM/utils/generate_resources.py" "$HELIUM/resources/generate_resources.txt" "$HELIUM/resources"
  python3 "$HELIUM/utils/replace_resources.py" "$HELIUM_MAC/resources/platform_resources.txt" \
    "$HELIUM_MAC/resources" "$SRC"
  python3 "$HELIUM/utils/replace_resources.py" "$HELIUM/resources/helium_resources.txt" \
    "$HELIUM/resources" "$SRC"
  if [ -f "$ROOT/resources/rooster_resources.txt" ]; then
    python3 "$HELIUM/utils/replace_resources.py" "$ROOT/resources/rooster_resources.txt" \
      "$ROOT/resources" "$SRC"
  fi

  log "rebranding (Helium → $(product_name))"
  python3 "$ROOT/scripts/rebrand.py" --tree "$SRC" --helium "$HELIUM" --config "$ROOT/config/branding.ini"
  echo done > "$PREPARED"

  if [ "$(uname -s)" = Darwin ]; then
    cmd_icons || log "warning: the app icon wasn't compiled, so the app shows Helium's; fix and rerun 'scripts/rooster icons'"
  fi
}

# Installs Rooster's macOS icon catalog and compiles it into Assets.car with
# Xcode's actool. Safe to rerun.
cmd_icons() {
  [ "$(uname -s)" = Darwin ] || die "icons: needs macOS (Xcode's actool)"
  [ -d "$SRC/chrome/app/theme/chromium/mac" ] || die "no prepared source in $SRC"
  local mac="$SRC/chrome/app/theme/chromium/mac" catalog="$ROOT/resources/branding/mac"
  log "installing the macOS app icon"
  rm -rf "$mac/AppIcon.icon" "$mac/Assets.xcassets/AppIcon.appiconset"/*.png "$mac/Assets.xcassets/Icon.iconset"
  cp -R "$catalog/AppIcon.icon" "$mac/AppIcon.icon"
  cp "$catalog/AppIcon.appiconset"/*.png "$mac/Assets.xcassets/AppIcon.appiconset/"
  cp -R "$catalog/Icon.iconset" "$mac/Assets.xcassets/Icon.iconset"
  cp "$ROOT/resources/branding/app.icns" "$mac/app.icns"
  (cd "$SRC" && python3 tools/mac/icons/compile_car.py --verbose "$mac/Assets.xcassets")
}

cmd_configure() {
  local mode="${1:-dev}" extra=()
  case "$mode" in dev|release) ;; *) die "configure: dev or release" ;; esac
  [ "$(cat "$PREPARED" 2>/dev/null)" = done ] || die "source isn't fully prepared; run 'prepare'"

  local cpu=arm64
  [ "$(host_arch)" = x64 ] && cpu=x64
  extra+=(--set "target_cpu=\"$cpu\"")
  if command -v sccache >/dev/null 2>&1; then
    extra+=(--set 'cc_wrapper="sccache"')
  elif command -v ccache >/dev/null 2>&1; then
    extra+=(--set 'cc_wrapper="env CCACHE_COMPILERCHECK=content CCACHE_SLOPPINESS=time_macros ccache"')
  fi

  log "writing $OUT/args.gn ($mode)"
  python3 "$ROOT/scripts/gn_args.py" "$HELIUM/flags.gn" "$HELIUM_MAC/flags.macos.gn" \
    "$ROOT/config/flags.gn" "$ROOT/config/flags.$mode.gn" "${extra[@]}" --out "$OUT/args.gn"

  cd "$SRC"
  python3 build/config/siso/configure_siso.py \
    --rbe_instance=projects/rbe-chrome-untrusted/instances/default_instance \
    --reapi_address= --reapi_instance= --reapi_backend_config_path=
  buildtools/mac/gn gen "$OUT" --fail-on-unused-args
}

cmd_build() {
  [ -f "$OUT/args.gn" ] || die "not configured; run 'configure'"
  cd "$SRC"
  # sccache defaults to 10 GB of cache; on a small disk that's better spent on
  # the build itself. Takes effect when sccache's server starts.
  SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-5G}" \
  SISO_PATH="$SRC/third_party/siso/cipd/siso" \
    python3 third_party/depot_tools/autoninja.py -C "$OUT" -j "$JOBS" "${@:-chrome}"
}

cmd_run() {
  local name app
  name="$(product_name)"
  app="$OUT/$name.app/Contents/MacOS/$name"
  [ -x "$app" ] || die "no build at $app; run 'build'"
  exec "$app" --user-data-dir="$BUILD/profile-dev" "$@"
}

cmd_reset() {
  log "removing $SRC (downloads in $CACHE are kept)"
  rm -rf "$SRC" "$PREPARED" "$BUILD/.pruned" "$BUILD/patches"
}

cmd_setup() {
  cmd_doctor
  cmd_download
  cmd_prepare
  cmd_configure dev
  log "ready: scripts/rooster build (first build takes several hours)"
}

command="${1:-}"
[ -n "$command" ] || { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
shift
case "$command" in
  doctor|setup|fetch|download|prepare|icons|configure|build|run|reset) "cmd_$command" "$@" ;;
  *) die "unknown command: $command" ;;
esac
