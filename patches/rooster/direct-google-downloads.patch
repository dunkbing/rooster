-    if (!ShouldAccessDictionaryService(prefs)) {
-        return GetDummyURL();
-    }
-
-    return GetServicesBaseURL(prefs).Resolve("/dict/");
+    return GURL("https://redirector.gvt1.com/edgedl/chrome/dict/");
 }
 
